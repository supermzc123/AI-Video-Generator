AIVIDEO_COMFYUI_ROOT=D:/path/to/ComfyUI
AIVIDEO_COMFYUI_BASE_URL=http://127.0.0.1:8188
AIVIDEO_REQUEST_TIMEOUT_SECONDS=3
AIVIDEO_DATA_ROOT=./data
# AIVIDEO_LLM_BASE_URL=https://api.example.com/v1
# AIVIDEO_LLM_MODEL=your-model
# AIVIDEO_LLM_API_KEY=
# AIVIDEO_LLM_VIDEO_CAPABLE=false
# Optional fallback for pinned Harness downloads, e.g. mixed:10808.
# AIVIDEO_NETWORK_PROXY=mixed:10808
AIVIDEO_FFMPEG_BINARY=ffmpeg
# Remote Worker endpoints stay disabled until this token is configured.
# Store the production value in Windows Credential Manager or the Linux keyring.
# AIVIDEO_WORKER_AUTH_TOKEN=
AIVIDEO_REMOTE_LEASE_SECONDS=60
